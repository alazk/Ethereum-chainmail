# Postgres connection string (Neon or Supabase). Use the pooled URL on Vercel.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Ethereum mainnet RPC (Alchemy, QuickNode, Infura...). Free tiers are enough.
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key

# Shared secret for /api/cron/ingest. Vercel cron sends it automatically when set.
CRON_SECRET=make-a-long-random-string

# Secret for the moderation endpoint /api/admin/hide.
ADMIN_SECRET=another-long-random-string

# Optional. First block to index when the database is empty.
# Leave unset to start ~50 blocks behind the chain head.
# START_BLOCK=21000000

# Optional. Connections per server instance (default 3).
# DATABASE_POOL_SIZE=3
